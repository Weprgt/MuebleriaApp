<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F1EA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetalle"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#6D4C41"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#FFFFFF"
        app:subtitle="Información del mueble"
        app:subtitleTextColor="#E9D8C7"
        app:title="Detalle del artículo"
        app:titleTextColor="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarDetalle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Fotografía -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                app:cardBackgroundColor="#E9D8C7"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#D3B99F"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgArticulo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Fotografía del artículo"
                    android:padding="70dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_sofa" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Información -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E4D8CE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtDetalleNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre del artículo"
                        android:textColor="#3E2723"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetallePrecio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="#8A6045"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPrecioDolares"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="≈ US$ --"
                        android:textSize="16sp"
                        android:textColor="#6D4C41" />

                    <TextView
                        android:id="@+id/tvFuenteTipoCambio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tipo de cambio: ExchangeRate-API"
                        android:textSize="11sp"
                        android:textColor="#757575" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/txtDetalleCategoria"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="Categoría"
                        android:textColor="#6D4C41"
                        android:textSize="14sp"
                        app:chipBackgroundColor="#F1E4D8"
                        app:ensureMinTouchTargetSize="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#E4D8CE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Descripción"
                        android:textColor="#3E2723"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetalleDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Descripción completa del artículo"
                        android:textColor="#786861"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Botón editar -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:minHeight="58dp"
                android:text="Editar artículo"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#6D4C41"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#FFFFFF" />

            <!-- Botón eliminar -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="Eliminar artículo"
                android:textAllCaps="false"
                android:textColor="#A33B32"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#A33B32"
                app:strokeColor="#A33B32"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>